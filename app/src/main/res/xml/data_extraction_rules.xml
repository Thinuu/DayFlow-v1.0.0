<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Data Extraction Rules (API 31+).
    https://developer.android.com/about/versions/12/backup-restore#xml-changes

    Governs both cloud backup (Google Drive Auto Backup) and device-to-device
    transfer (e.g. Quick Switch Adapter, Google One Tap Transfer).

    POLICY: Exclude the Room database and DataStore from both backup and transfer.
    DayFlow stores unencrypted financial records in SQLite. Uploading those files
    to cloud backup without user consent is a privacy and security issue.
    Users should use the in-app JSON backup feature for intentional data migration.
-->
<data-extraction-rules>

    <cloud-backup>
        <!-- Room database and its WAL/SHM files -->
        <exclude domain="database" path="dayflow_database" />
        <exclude domain="database" path="dayflow_database-shm" />
        <exclude domain="database" path="dayflow_database-wal" />

        <!-- DataStore preferences file (contains PIN hash, currency preference, Pro flag) -->
        <exclude domain="file" path="datastore/dayflow_user_preferences.preferences_pb" />

        <!-- Export cache — temporary files only, no value in backing up -->
        <exclude domain="file" path="exports/" />
    </cloud-backup>

    <device-transfer>
        <!-- Same exclusions apply to device-to-device transfers -->
        <exclude domain="database" path="dayflow_database" />
        <exclude domain="database" path="dayflow_database-shm" />
        <exclude domain="database" path="dayflow_database-wal" />
        <exclude domain="file" path="datastore/dayflow_user_preferences.preferences_pb" />
        <exclude domain="file" path="exports/" />
    </device-transfer>

</data-extraction-rules>
